/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    top
    {
        type            calculated;
        value           uniform 0;
    }
    bottom
    {
        type            calculated;
        value           uniform 0;
    }
    sideMinusY
    {
        type            calculated;
        value           uniform 0;
    }
    sidePlusY
    {
        type            symmetryPlane;
    }

    wing
    {
        type            nutUSpaldingWallFunction; //This is changed from nutLowReWallFunction as boundary layers were retired.
        value           uniform 0;
    }
}

