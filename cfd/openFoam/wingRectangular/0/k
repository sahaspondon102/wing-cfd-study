/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// k = 1.5*(U*I)^2 with 3% freestream turbulence intensity. U = 30 ms^1
internalField   uniform 1.215;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1.215;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1.215;
        value           uniform 1.215;
    }

    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            zeroGradient;
    }
    sideMinusY
    {
        type            zeroGradient;
    }
    sidePlusY
    {
        type            symmetryPlane;
    }

    wing
    {
        type            kqRWallFunction;
        value           uniform 1.215;
    }
}

// ************************************************************************* //
